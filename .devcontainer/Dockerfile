# The development and CI image for meraki/messageformat.
#
# ## Why a container at all
#
# This package requires ext-intl, and intl is the one dependency whose *version* changes the
# answers. ICU carries CLDR, CLDR carries the plural rules and the number and date formats, and
# some of the Unicode conformance suite's expected strings are CLDR data rather than library
# logic. A library whose correctness is defined against a data version cannot be developed
# against "whatever ICU the machine happens to have" — so the version is declared here, in a
# file, next to the code that depends on it.
#
# It also means nobody has to enable an extension in a global php.ini to run the tests.
#
# ## The ICU lever
#
# PHP_BASE is the only knob, because ICU comes from the base image's distribution:
#
#   8.5-cli-bookworm   Debian 12   ICU 72   CLDR 42
#   8.5-cli-trixie     Debian 13   ICU 76   CLDR 46   <- the default
#
# No distribution packages ICU 77 (CLDR 47), which is the release MessageFormat 2 became Stable
# in. Matching it exactly would mean building ICU from source, and that is deliberately not done
# here: the conformance fixtures are generated by the working group's JavaScript implementation
# rather than by ICU, so pinning ICU 77 would not make them more authoritative. It would only
# change what :number and :date print. The suite's ICU-sensitive assertions are quarantined in
# the `icu` PHPUnit group instead, and compose.yaml runs the matrix.

ARG PHP_BASE=8.5-cli-trixie
FROM php:${PHP_BASE}

# Repeated after FROM because an ARG before it is out of scope in the build stage, and the image
# should be able to report what it was built from.
ARG PHP_BASE
ENV MERAKI_PHP_BASE=${PHP_BASE}

ARG USERNAME=dev
ARG USER_UID=1000
ARG USER_GID=${USER_UID}

# libicu-dev is kept rather than removed after the build. On a runtime image it would be dead
# weight; here it is what lets someone rebuild intl inside the container while debugging.
RUN set -eux; \
	apt-get update; \
	apt-get install -y --no-install-recommends \
		ca-certificates \
		curl \
		git \
		gnupg \
		less \
		libicu-dev \
		libzip-dev \
		openssh-client \
		unzip \
		zip; \
	docker-php-ext-configure intl; \
	docker-php-ext-install -j"$(nproc)" intl zip; \
	pecl install xdebug; \
	docker-php-ext-enable xdebug; \
	apt-get clean; \
	rm -rf /var/lib/apt/lists/*

# The GitHub CLI, so that repository and pull-request work happens in the same environment as
# everything else. Only on the development image — the matrix images in compose.yaml run tests
# and nothing else, and adding an apt repository to them would be weight for no purpose.
#
# Authentication is not baked in and must not be: run `gh auth login` inside the container, or
# let VS Code's Dev Containers credential forwarding supply it. A token copied into an image
# layer would be readable by anyone who pulled it.
RUN set -eux; \
	install -m 0755 -d /etc/apt/keyrings; \
	curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
		-o /etc/apt/keyrings/githubcli-archive-keyring.gpg; \
	chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg; \
	echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg]" \
		"https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list; \
	apt-get update; \
	apt-get install -y --no-install-recommends gh; \
	apt-get clean; \
	rm -rf /var/lib/apt/lists/*

# The workspace arrives as a bind mount whose ownership git may not recognise as its own. Marked
# safe here rather than left for the first confusing "dubious ownership" error.
RUN git config --system --add safe.directory /workspace

# Coverage off by default: Xdebug's coverage mode costs roughly an order of magnitude on every
# run, and `composer test:coverage` turns it on through XDEBUG_MODE for the one run that needs
# it. Leaving it on here would make the fast feedback loop slow for no benefit.
RUN { \
		echo 'xdebug.mode=off'; \
		echo 'xdebug.start_with_request=no'; \
		echo 'xdebug.client_host=host.docker.internal'; \
		echo 'xdebug.client_port=9003'; \
	} > /usr/local/etc/php/conf.d/zz-xdebug.ini

# The suite asserts on exact strings, so anything that can vary per machine is pinned. A
# container that formatted dates in the host's timezone would give a different answer on a
# colleague's laptop, which is the whole failure mode this file exists to remove.
RUN { \
		echo 'date.timezone=UTC'; \
		echo 'memory_limit=1G'; \
		echo 'error_reporting=E_ALL'; \
		echo 'display_errors=On'; \
		echo 'zend.assertions=1'; \
	} > /usr/local/etc/php/conf.d/zz-meraki.ini

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

RUN set -eux; \
	groupadd --gid "${USER_GID}" "${USERNAME}"; \
	useradd --uid "${USER_UID}" --gid "${USER_GID}" --create-home --shell /bin/bash "${USERNAME}"; \
	mkdir -p /home/"${USERNAME}"/.composer; \
	chown -R "${USER_UID}:${USER_GID}" /home/"${USERNAME}"; \
	# Docker seeds an empty named volume from whatever the image has at the mount point,
	# ownership included. Creating these as the unprivileged user is therefore what makes the
	# vendor and composer-cache volumes writable without a chown on first run — otherwise they
	# arrive root-owned and `composer install` fails as the very first thing anyone tries.
	mkdir -p /workspace/vendor; \
	chown -R "${USER_UID}:${USER_GID}" /workspace

ENV COMPOSER_HOME=/home/${USERNAME}/.composer
ENV COMPOSER_ALLOW_SUPERUSER=0
ENV COMPOSER_NO_INTERACTION=1

USER ${USERNAME}
WORKDIR /workspace
